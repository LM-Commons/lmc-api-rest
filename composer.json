{
  "name": "lm-commons/lmc-api-rest",
  "description": "API Tools to process REST requests",
  "license": "BSD-3-Clause",
  "type": "librery",
  "authors": [
    {
      "name": "Eric Richer",
      "email": "eric.richer@vistoconsulting.com.com"
    }
  ],
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "laminas/laminas-eventmanager": "^3.14",
    "laminas/laminas-inputfilter": "^2.0",
    "laminas/laminas-paginator": "^2.0",
    "laminas/laminas-stdlib": "^3.0",
    "lm-commons/lmc-api-auth": "1.x-dev",
    "lm-commons/lmc-api-problem": "1.0.x-dev ",
    "mezzio/mezzio-router": "^3.7",
    "mezzio/mezzio-problem-details": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/http-server-handler": "^1.0",
    "laminas/laminas-diactoros": "^3.8",
    "mezzio/mezzio-hal": "^2.12"
  },
  "require-dev": {
    "laminas/laminas-coding-standard": "^3.1",
    "phpunit/phpunit": "^12.5",
    "psalm/plugin-phpunit": "^0.19.5",
    "vimeo/psalm": "^6.14"
  },
  "autoload": {
    "psr-4": {
      "Lmc\\Api\\Rest\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LmcTest\\Api\\Rest\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.99"
    }
  },
  "extra": {
    "lamimas": {
      "config-provider": "Lmc\\Api\\Rest\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover ./build/logs/clover.xml",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test-coverage-html": "phpunit --coverage-html ./build/html",
    "static-analysis": "psalm --shepherd --stats"
  },
  "repositories": [
    {
      "type": "git",
      "url": "c:/lm-commons/lmc-api-auth"
    },
    {
      "type": "git",
      "url": "https://github.com/LM-Commons/lmc-api-problem.git"
    }
  ]
}
